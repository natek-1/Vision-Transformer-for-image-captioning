# Keep the build context small and the image lean.

# Other large weights file not used by app.py (CHECKPOINT_PATH=best_meteor_model.pt)
model_weights.pt

# Python caches / envs
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
env/

# Training / dev artifacts
plotsv2/
*.png
vision/train/
vision/dataset/

